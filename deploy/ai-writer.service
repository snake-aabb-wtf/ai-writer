[Unit]
Description=AI Writer novel creation workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/data1/project/AI Writer
ExecStart=/home/ubuntu/.nvm/versions/node/v24.16.0/bin/node --env-file=.env dist/src/server.js
Restart=on-failure
RestartSec=5s
Environment=NODE_ENV=production
UMask=0077

[Install]
WantedBy=multi-user.target
